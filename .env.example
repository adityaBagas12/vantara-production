APP_NAME="Vantara Production"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vantara_production
DB_USERNAME=your_database_username
DB_PASSWORD=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@vantara.id"
MAIL_FROM_NAME="Vantara Production"

VITE_APP_NAME="Vantara Production"
